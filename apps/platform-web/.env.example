VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional production map tile provider. EcoLearn defaults to the public
# OpenStreetMap tile server, which is appropriate for development and light use
# but has no uptime guarantee. Keep {z}, {x}, and {y} placeholders in the URL.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
