{
  "name": "mobile-ecolearn",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~57.0.19",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.15",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.15",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:go:tunnel": "expo start --go --tunnel",
    "start:clear": "expo start --dev-client --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check": "npx expo-doctor@latest && tsc --noEmit",
    "bundle:android": "expo export --platform android --output-dir .expo-validation/android --clear",
    "bundle:ios": "expo export --platform ios --output-dir .expo-validation/ios --clear",
    "eas:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "eas:ios:simulator": "npx eas-cli@latest build --platform ios --profile ios-simulator"
  },
  "private": true
}
