{
  "expo": {
    "name": "EcoScan",
    "slug": "ecoscan-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ecolearn-scanner",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "EcoScan uses your camera to identify a disposal item.",
        "NSPhotoLibraryUsageDescription": "EcoScan lets you choose an item photo to identify it."
      },
      "bundleIdentifier": "com.ecolearn.ecoscan"
    },
    "android": {
      "package": "com.ecolearn.ecoscan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
